# =============================================================
# Voice AI Patient Registration Agent — Environment Variables
# Copy this file to .env and fill in ALL values before running
# NEVER commit .env to git
# =============================================================

# -------------------------------------------------------------
# Vapi (Telephony + Voice AI)
# Dashboard: https://dashboard.vapi.ai
# -------------------------------------------------------------
VAPI_PRIVATE_KEY=ec6eaea4-814d-4b19-a6fe-f39859281732
VAPI_PUBLIC_KEY=c8497c55-6bea-470c-a05b-6bef46e087ae

# The ID of your provisioned Vapi phone number (NOT the number itself)
VAPI_PHONE_NUMBER_ID=95990ced-27a5-475c-85c6-d402288bc30a

# The actual dial-in number (for display / README)
VAPI_PHONE_NUMBER=+13854069126

# -------------------------------------------------------------
# LLM Provider — Google Gemini
# Dashboard: https://aistudio.google.com/app/apikey
# -------------------------------------------------------------
GEMINI_API_KEY=AQ.Ab8RN6L9hl6IflT6jneiRfX2_bEWMZzKLKHmhzlKgufH89lfLw

# Model to use (gemini-2.0-flash is fast + free tier)
GEMINI_MODEL=gemini-2.0-flash

# -------------------------------------------------------------
# Database (SQLite — no external service needed)
# Change path after Railway deploy to match volume mount
# -------------------------------------------------------------
# Local development:
DATABASE_URL=sqlite:///./data/patients.db
# Railway with persistent volume (update after deploy):
# DATABASE_URL=sqlite:////app/data/patients.db

# -------------------------------------------------------------
# API
# Set AFTER Railway gives you a deployed URL
# Used by: Vapi tool serverUrl, seed script, setup_vapi.py
# -------------------------------------------------------------
API_BASE_URL=

# -------------------------------------------------------------
# CORS (comma-separated allowed origins, * for all)
# -------------------------------------------------------------
CORS_ORIGINS=*
